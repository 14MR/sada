# SADA Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=your-secure-jwt-secret-here

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:19006,http://localhost:3000

# Database (PostgreSQL)
# When using docker compose, DB_HOST is overridden to "postgres" (the service name).
# These individual vars are used by the app; DATABASE_URL is not read by the app
# but can be useful for psql/external tools.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/sada
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=sada

# Apple Sign-In
APPLE_BUNDLE_ID=com.sada.app
APPLE_CLIENT_ID=com.sada.app

# Push Notifications (Expo)
PUSH_NOTIFICATION_KEY=

# Cloudflare TURN / Calls (required in production)
CLOUDFLARE_APP_ID=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_APP_SECRET=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=5

# Logging
LOG_LEVEL=info

# Domain (production only)
# VIRTUAL_HOST=sada.example.com
# LETSENCRYPT_HOST=sada.example.com
# LETSENCRYPT_EMAIL=admin@example.com
